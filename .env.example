# Copy to .env and fill in (then `export $(grep -v '^#' .env | xargs)` or use a tool like direnv).

# Required
TEMPO_API_TOKEN=

# Optional: custom Tempo API endpoint URL (default: https://api.tempo.io/4)
# TEMPO_BASE_URL=https://api.tempo.io/4

# Optional: only needed to auto-resolve issue keys (e.g. PROJ-123) and your accountId
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_API_TOKEN=

# Optional: skips Jira accountId auto-detection when JIRA_API_TOKEN isn't set
JIRA_ACCOUNT_ID=

# Optional: submission safety & workflow automation settings
# TEMPO_DAILY_CAP_HOURS=8.0
# TEMPO_ROUND_MINUTES=15
# TEMPO_DEFAULT_ISSUE=PROJ-123
# TEMPO_MEETING_ISSUE=PROJ-456

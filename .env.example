# Copy to .env and fill in (then `export $(grep -v '^#' .env | xargs)` or use a tool like direnv).

# Required
TEMPO_API_TOKEN=

# Optional: only needed to auto-resolve issue keys (e.g. PROJ-123) and your accountId
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_API_TOKEN=

# Optional: skips Jira accountId auto-detection when JIRA_API_TOKEN isn't set
JIRA_ACCOUNT_ID=
